{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenXlate",
  "version": "0.1.0",
  "identifier": "com.openxlate.app",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:5714",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenXlate",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
